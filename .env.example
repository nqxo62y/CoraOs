# CoraOS Server Configuration
# Copy this file to .env and adjust values for your environment.

# Server bind address (0.0.0.0 for LAN access)
CORAOS_HOST=0.0.0.0
CORAOS_PORT=8080

# Database path (SQLite)
DATABASE_URL=sqlite:../data/coraos.db?mode=rwc

# JWT secret key (CHANGE THIS in production!)
# Generate with: openssl rand -hex 64
JWT_SECRET=change_this_to_a_random_64_char_hex_string

# JWT token expiration in hours
JWT_EXPIRATION_HOURS=24

# Backup storage directory
BACKUP_PATH=../backups

# Log storage directory
LOG_PATH=../logs

# Logging level (trace, debug, info, warn, error)
RUST_LOG=coraos_backend=info,tower_http=info
